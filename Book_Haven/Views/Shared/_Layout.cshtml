<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Cinzel+Decorative:wght@400;700&display=swap" rel="stylesheet">
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fall2024_Assignment3_separal</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/Fall2024_Assignment3_separal.styles.css" asp-append-version="true" />
    <style>
        /* Apply background image to the navbar */
        .navbar {
            background-image: url('/WoodBack.png');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
        }

            /* Style for navigation buttons */
            .navbar .nav-link {
                background-color: rgba(255, 255, 255, 0.8); /* White background with 80% opacity */
                border-radius: 5px; /* Rounded corners */
                padding: 5px 10px; /* Padding for button appearance */
                margin-right: 5px; /* Space between buttons */
                transition: background-color 0.3s; /* Smooth transition on hover */
            }

                .navbar .nav-link:hover {
                    background-color: rgba(255, 255, 255, 1); /* Fully opaque white on hover */
                    color: #000; /* Dark text color for contrast */
                    text-decoration: none; /* Remove underline */
                }

        /* Style for the navbar brand */
        .navbar-brand {
            font-family: 'Cinzel Decorative', serif;
        }

        /* General body styles */
        body {
            background-color: #f5f5f5; /* Light gray background for contrast */
            height: 100vh;
            margin: 0;
            padding-top: 30px; /* Adjust based on navbar height */
        }

        /* Add padding to the top of the main content to avoid being cut off by the navbar */
        main {
            padding-top: 70px; /* Adjust this value based on the height of your navbar */
        }

        /* Chatbox styles */
        #chatbox {
            position: fixed;
            bottom: 20px;
            right: 20px;
            width: 300px;
            background-color: white;
            font-family: 'Cinzel Decorative', serif;
            border: 1px solid #ccc;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
            padding: 10px;
        }

        #messages {
            max-height: 200px;
            font-family: 'Cinzel Decorative', serif;
            overflow-y: auto;
            margin-bottom: 10px;
        }

        #userInput {
            width: calc(100% - 60px);
            margin-right: 10px;
        }

        #sendButton {
            width: 60px;
            border-radius: 10px;
            font-family: 'Cinzel Decorative', serif;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light border-bottom box-shadow mb-3 fixed-top">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Book Haven</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Books" asp-action="Index">Books</a>
                        </li>

                        @if (User.Identity.IsAuthenticated)
                        {
                            if (User.IsInRole("User") || User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="BookClicks" asp-action="Index">Reports</a>
                                </li>
                            }

                            if (User.IsInRole("Admin"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="" asp-controller="AdminTools" asp-action="Index">Admin Tools</a>
                                </li>
                            }
                        }
                    </ul>

                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Chatbox -->
    <div id="chatbox">
        <h3>AI Librarian</h3> <!-- Add a label for the chatbox -->

        <div id="messages-container" style="display: none;">
            <div id="messages"></div>
        </div>
        <input type="text" id="userInput" placeholder="Type a message..." />
        <button id="sendButton">Send</button>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <script>
        document.getElementById('sendButton').addEventListener('click', async () => {
            const userInput = document.getElementById('userInput').value;

            // Ensure the input is not empty before sending
            if (!userInput.trim()) {
                alert("Please enter a message!");
                return;
            }

            // Show the messages container if it's hidden
            const messagesContainer = document.getElementById('messages-container');
            if (messagesContainer.style.display === 'none') {
                messagesContainer.style.display = 'block';
            }

            // Add the user's message to the chat display
            const messages = document.getElementById('messages');
            messages.innerHTML += `<div class="message user-message"><span class="user-name">User:</span> ${userInput}</div>`;

            // Clear the input field
            document.getElementById('userInput').value = '';

            // Send the message to the server
            const response = await fetch('/Chat/SendMessage', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ message: userInput })
            });

            try {
                const data = await response.json();

                if (data.response) {
                    // Display AI's response in the chat
                    messages.innerHTML += `<hr class="message-divider"><div class="message ai-message"><span class="ai-name">AI:</span> ${data.response}</div>`;
                } else if (data.error) {
                    messages.innerHTML += `<hr class="message-divider"><div class="message ai-message"><span class="ai-name">Error:</span> ${data.error}</div>`;
                }
            } catch (err) {
                console.error("Error parsing response:", err);
                messages.innerHTML += `<hr class="message-divider"><div class="message ai-message"><span class="ai-name">Error:</span> Could not process the AI response</div>`;
            }

            // Scroll to the bottom of the chat
            messages.scrollTop = messages.scrollHeight;
        });
    </script>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
        }

        #chatbox {
            max-width: 600px;
            margin: 20px auto;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 5px;
            background-color: #f9f9f9;
        }

        #messages {
            height: 400px;
            overflow-y: auto;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 5px;
            background-color: #fff;
        }

        .message {
            margin: 10px 0;
            padding: 10px;
            border-radius: 5px;
            border: 1px solid #ccc;
        }

        .user-message {
            background-color: #e1ffe8;
            text-align: right;
        }

        .ai-message {
            background-color: #f8e7d9;
            text-align: left;
        }

        .user-name {
            color: green;
            font-weight: bold;
        }

        .ai-name {
            color: orange;
            font-weight: bold;
        }

        .message-divider {
            border: none;
            border-top: 1px solid #ccc;
            margin: 10px 0;
        }
    </style>
</body>
</html>
